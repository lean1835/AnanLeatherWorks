{
    "name": "ananleather-works-backend",
    "version": "1.0.0",
    "private": true,
    "description": "Backend API for AnanLeather Works Repair Management System",
    "main": "dist/server.js",
    "packageManager": "npm@10.9.7",
    "engines": {
        "node": ">=22.22 <25",
        "npm": ">=10"
    },
    "scripts": {
        "clean": "rimraf dist",
        "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/server.ts",
        "typecheck": "tsc --noEmit --pretty false",
        "lint": "eslint \"src/**/*.ts\"",
        "lint:fix": "npm run lint -- --fix",
        "test": "node --test tests/security-regressions.test.js",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.js\" \"scripts/**/*.mjs\" \"*.{js,json,mjs,yml,yaml}\" .prettierrc",
        "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.js\" \"scripts/**/*.mjs\" \"*.{js,json,mjs,yml,yaml}\" .prettierrc",
        "build": "npm run clean && tsc && tscpaths -p tsconfig.json -s ./src -o ./dist",
        "validate:env": "node scripts/validate-env.mjs",
        "start": "node dist/server.js",
        "start:prod": "npm run validate:env && node dist/server.js",
        "check": "npm run typecheck && npm run lint && npm test"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.758.0",
        "@aws-sdk/s3-request-presigner": "^3.758.0",
        "bcryptjs": "^3.0.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "joi": "^17.13.4",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.10.1",
        "multer": "^1.4.5-lts.1",
        "pdfkit": "^0.16.0",
        "sharp": "^0.35.3",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.23",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.13.4",
        "@types/pdfkit": "^0.13.9",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.8.0",
        "prettier": "^3.9.6",
        "rimraf": "^6.1.3",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "tscpaths": "^0.0.9",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.65.0"
    }
}
