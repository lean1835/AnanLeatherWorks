# Server
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# Optional business details rendered on generated documents
BUSINESS_NAME=Anan Leather Works
BUSINESS_HOTLINE=
BUSINESS_WEBSITE=
BUSINESS_LOCATION=

# Optional absolute paths. Configure both together to override system DejaVu/Windows fonts.
PDF_FONT_REGULAR=
PDF_FONT_BOLD=

ENABLE_DEV_SEED=false

# Leave empty to keep account bootstrap closed. If an empty database must be
# initialized, use a one-time random token of at least 32 characters and unset it afterwards.
AUTH_BOOTSTRAP_TOKEN=

# MongoDB (use a dedicated, least-privilege user outside local development)
MONGODB_URI=mongodb://127.0.0.1:27017/ananleather_works?replicaSet=rs0

# Generate independent random values of at least 32 characters.
JWT_SECRET=replace_with_a_random_value_of_at_least_32_characters
COOKIE_SECRET=replace_with_a_different_random_value_of_at_least_32_characters
# Keep strict for same-site/custom-domain deployments. Use none only when the
# production frontend and API are on different sites, such as two onrender.com hosts.
COOKIE_SAME_SITE=strict

# Cloudflare R2 is required in production. Never commit real credentials.
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
R2_BUCKET_NAME=ananleather-works-images
R2_PUBLIC_DOMAIN=https://media.example.com
